{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}
<header class="store-header luxury-header">

  {# Top Nav — slim utility bar #}
  <div class="top-navbar">
    <div class="container flex justify-between items-center">

      <div class="flex-1 flex items-center gap-2">
        {# Footer Menu — pages/links #}
        {% if important_links %}
          <salla-menu source="footer" topnav></salla-menu>
        {% endif %}

        {# Language & Currency #}
        <div class="header-buttons">
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <salla-localization-modal show-trigger></salla-localization-modal>
          {% endif %}
        </div>

        {# Branch Scope #}
        {% if store.scope %}
          <button class="btn--rounded-gray"
                  onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
            <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
          </button>
        {% endif %}

        {# Search — hidden on mobile (main nav has no search, keeps top nav purpose clear) #}
        <div class="header-search flex-1 hidden sm:flex">
          <salla-search inline oval height="32"></salla-search>
        </div>
      </div>

      <salla-contacts is-header></salla-contacts>
    </div>
  </div>

  {# Main Nav — sticky, gold-accented #}
  <div id="mainnav" class="main-nav-container luxury-mainnav shadow-default bg-white flex items-center">
    <div class="inner bg-inherit w-full">
      <div class="container">
        <div class="flex items-stretch justify-between relative">

          {# Left: Hamburger + Logo + Desktop Menu #}
          <div class="flex items-center gap-2 lg:gap-4">
            {# Mobile hamburger #}
            <a class="lg:hidden mburger mburger--collapse leading-none"
               href="#mobile-menu"
               aria-label="{{ trans('accessibility.open_menu') }}">
              <i class="sicon-menu text-primary text-2xl"></i>
            </a>

            {# Brand Logo #}
            <a class="navbar-brand" href="{{ store.url }}">
              <img fetchpriority="high"
                   width="100%"
                   height="100%"
                   loading="eager"
                   src="{{ store.logo|cdn(175) }}"
                   alt="{{ store.name }}">
              {% if is_page('index') %}
                <h1 class="sr-only">{{ store.name }}</h1>
              {% else %}
                <h2 class="sr-only">{{ store.name }}</h2>
              {% endif %}
            </a>

            {# Desktop Navigation #}
            <custom-main-menu></custom-main-menu>
          </div>

          {# Right: Search (mobile) + User + Cart #}
          <div class="flex items-center justify-end gap-1 my-2.5">

            {# Mobile search trigger — visible only on mobile #}
            <div class="flex sm:hidden">
              <salla-search show-trigger oval height="36">
                <i slot="trigger-icon" class="sicon-search text-xl text-gray-600"></i>
              </salla-search>
            </div>

            {# User Account #}
            <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>

            {# Cart #}
            <salla-cart-summary class="rtl:mr-2 ltr:ml-2">
              <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
            </salla-cart-summary>

          </div>
        </div>
      </div>
    </div>
  </div>

</header>
