{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides[].without_overlay | bool |                                                                              |
| position                       | int      | Sorting number start from zero                                               |
#}
<section class="s-block s-block--hero-slider s-block--full-bg wide-placeholder luxury-hero">
  <salla-slider
    id="main-slider-{{ position }}"
    auto-play
    static-when-single
    slider-config='{"lazy":"false","speed":800,"parallax":true}'
    {{ component.slides|length > 1 ? '' : 'show-controls="false"' }}
    type="fullwidth">

    <div slot="items">
      {% for slide in component.slides %}
        <div class="swiper-slide luxury-hero__slide w-full relative">

          {# Background image #}
          <div class="luxury-hero__bg {{ slide.without_overlay ? '' : 'luxury-hero__bg--overlay' }}"
               style="background-image: url({{ slide.image }});"></div>

          {# Content #}
          {% if slide.title or slide.description %}
            <div class="luxury-hero__content container">
              <div class="luxury-hero__text">
                {% if slide.title %}
                  <h2 class="luxury-hero__title font-display"
                      data-swiper-parallax="-400">
                    {{ slide.title }}
                  </h2>
                {% endif %}

                {% if slide.description %}
                  <p class="luxury-hero__desc"
                     data-swiper-parallax="-200">
                    {{ slide.description }}
                  </p>
                {% endif %}

                {# Gold divider line — brand signature #}
                <span class="luxury-hero__divider" data-swiper-parallax="-150" aria-hidden="true"></span>
              </div>
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </salla-slider>
</section>
